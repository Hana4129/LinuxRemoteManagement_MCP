[Unit]
Description=Linux Remote Management Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lrm-mcp-agent
Group=lrm-mcp-agent
ExecStart=/usr/local/bin/lrm-mcp-agent --config /etc/lrm-mcp-agent/config.yml
Restart=on-failure
RestartSec=5
WorkingDirectory=/var/lib/lrm-mcp-agent

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lrm-mcp-agent /var/log/lrm-mcp-agent
PrivateTmp=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
