# Copy to /etc/linux-mcp-server/env and chmod 600.
# Do not commit the real file.
LINUX_MCP_CONSOLE_USER=admin
LINUX_MCP_CONSOLE_PASS=replace-with-a-secret
LINUX_MCP_AGENT_ADMIN_TOKEN=replace-with-agent-sync-secret
# Used by stdio clients only when launching app.mcp_entry.
# LINUX_MCP_TOKEN=replace-with-user-token
